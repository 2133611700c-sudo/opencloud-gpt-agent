{
  "schema_version": 1,
  "name": "ECC OpenClaw Orchestration Policy",
  "phases": ["scope", "discover", "plan", "execute", "repair", "review", "verify", "judge", "evidence", "learn"],
  "deepseek": {
    "primary": "deepseek/deepseek-flash",
    "fallbacks": ["deepseek/deepseek-v4-pro"],
    "image_model": "deepseek/deepseek-flash",
    "utility_model": "deepseek/deepseek-flash",
    "context_window": 1000000,
    "max_output_tokens": 384000,
    "reasoning": {"simple": "low", "default": "high", "complex": "max"},
    "capabilities": ["thinking", "tool_calls", "vision"]
  },
  "base_skills": [
    "agent-harness-construction",
    "agent-security-hardening",
    "verification-loop",
    "agent-self-evaluation"
  ],
  "orchestration_skills": [
    "plan-orchestrate",
    "team-agent-orchestration",
    "parallel-execution-optimizer",
    "agentic-engineering"
  ],
  "failure_skills": [
    "agent-introspection-debugging",
    "agent-architecture-audit",
    "ai-regression-testing",
    "security-review"
  ],
  "learning_skills": ["continuous-learning-v2", "skill-comply"],
  "role_lanes": {
    "supervisor": ["chief-of-staff", "planner", "architect", "agent-evaluator"],
    "discovery": ["code-explorer", "spec-miner", "docs-lookup"],
    "architecture": ["architect", "code-architect", "network-architect"],
    "repair": [
      "build-error-resolver", "cpp-build-resolver", "dart-build-resolver", "django-build-resolver",
      "go-build-resolver", "harmonyos-app-resolver", "java-build-resolver", "kotlin-build-resolver",
      "pytorch-build-resolver", "react-build-resolver", "rust-build-resolver", "swift-build-resolver",
      "network-troubleshooter", "silent-failure-hunter", "performance-optimizer", "refactor-cleaner"
    ],
    "review": [
      "code-reviewer", "security-reviewer", "database-reviewer", "typescript-reviewer", "react-reviewer",
      "python-reviewer", "go-reviewer", "rust-reviewer", "java-reviewer", "kotlin-reviewer",
      "swift-reviewer", "django-reviewer", "fastapi-reviewer", "flutter-reviewer", "php-reviewer",
      "ruby-reviewer", "cpp-reviewer", "csharp-reviewer", "fsharp-reviewer", "vue-reviewer",
      "mle-reviewer", "rag-pipeline-reviewer", "network-config-reviewer"
    ],
    "verification": ["e2e-runner", "pr-test-analyzer", "tdd-guide", "agent-evaluator"],
    "documentation": ["doc-updater", "comment-analyzer", "commit-reviewer"]
  },
  "extension_routes": {
    ".js": {"review": ["typescript-reviewer"], "repair": ["build-error-resolver"]},
    ".mjs": {"review": ["typescript-reviewer"], "repair": ["build-error-resolver"]},
    ".cjs": {"review": ["typescript-reviewer"], "repair": ["build-error-resolver"]},
    ".ts": {"review": ["typescript-reviewer"], "repair": ["build-error-resolver"]},
    ".tsx": {"review": ["react-reviewer", "typescript-reviewer"], "repair": ["react-build-resolver"]},
    ".jsx": {"review": ["react-reviewer", "typescript-reviewer"], "repair": ["react-build-resolver"]},
    ".py": {"review": ["python-reviewer"], "repair": ["build-error-resolver"]},
    ".go": {"review": ["go-reviewer"], "repair": ["go-build-resolver"]},
    ".rs": {"review": ["rust-reviewer"], "repair": ["rust-build-resolver"]},
    ".java": {"review": ["java-reviewer"], "repair": ["java-build-resolver"]},
    ".kt": {"review": ["kotlin-reviewer"], "repair": ["kotlin-build-resolver"]},
    ".kts": {"review": ["kotlin-reviewer"], "repair": ["kotlin-build-resolver"]},
    ".swift": {"review": ["swift-reviewer"], "repair": ["swift-build-resolver"]},
    ".dart": {"review": ["flutter-reviewer"], "repair": ["dart-build-resolver"]},
    ".php": {"review": ["php-reviewer"], "repair": ["build-error-resolver"]},
    ".rb": {"review": ["ruby-reviewer"], "repair": ["build-error-resolver"]},
    ".cpp": {"review": ["cpp-reviewer"], "repair": ["cpp-build-resolver"]},
    ".cc": {"review": ["cpp-reviewer"], "repair": ["cpp-build-resolver"]},
    ".cxx": {"review": ["cpp-reviewer"], "repair": ["cpp-build-resolver"]},
    ".cs": {"review": ["csharp-reviewer"], "repair": ["build-error-resolver"]},
    ".fs": {"review": ["fsharp-reviewer"], "repair": ["build-error-resolver"]},
    ".vue": {"review": ["vue-reviewer"], "repair": ["build-error-resolver"]}
  },
  "keyword_routes": {
    "repair": ["fix", "bug", "broken", "defect", "repair", "regression", "error", "failure", "failing", "crash"],
    "architecture": ["architecture", "architect", "design", "migration", "migrate", "refactor", "restructure", "network"],
    "security": ["auth", "oauth", "token", "secret", "password", "pii", "payment", "upload", "webhook", "prompt injection", "mcp", "tool call", "agent"],
    "testing": ["test", "coverage", "e2e", "integration", "regression"],
    "documentation": ["docs", "readme", "changelog", "documentation"]
  },
  "gates": {
    "write_requires_branch": true,
    "production_write_forbidden": true,
    "independent_judge_required": true,
    "security_review_for_agent_or_secret_surface": true,
    "retry_cap": 2,
    "evidence_required": true
  }
}
